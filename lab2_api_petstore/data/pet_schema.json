{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Schema de GET /pet/{petId}. Le contrat Swagger impose name et photoUrls ; id est exige en plus car la ressource est relue par son id.",
  "title": "Pet",
  "type": "object",
  "required": ["id", "name", "photoUrls"],
  "properties": {
    "id": {"type": "integer"},
    "category": {
      "type": "object",
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"}
      }
    },
    "name": {"type": "string", "minLength": 1},
    "photoUrls": {"type": "array", "items": {"type": "string"}},
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "name": {"type": "string"}
        }
      }
    },
    "status": {"type": "string", "enum": ["available", "pending", "sold"]}
  }
}
